<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xml:lang="en" tts:extent="1920px 1080px" ttp:cellResolution="40 20">
    <head>
        <styling>
            <style xml:id="base" tts:color="white" tts:textAlign="center"/>
            <style xml:id="topStyle" style="base" tts:origin="25% 5%"/>
        </styling>
        <layout>
            <region xml:id="bottom" tts:origin="10% 80%" tts:extent="80% 15%" tts:padding="1c 2c" tts:displayAlign="after" tts:textAlign="center"/>
            <region xml:id="top" style="topStyle" tts:extent="960px 108px"/>
        </layout>
    </head>
    <body>
        <div>
            <p begin="00:00:01.000" end="00:00:03.000" region="bottom">Bottom line</p>
            <p begin="00:00:04.000" end="00:00:06.000" region="top" style="base">Top line</p>
            <p begin="00:00:07.000" end="00:00:09.000">No region line</p>
        </div>
    </body>
</tt>
